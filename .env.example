# ── What to watch ─────────────────────────────────────────────
# The exam page URL (with its examId). Also accepted as --url.
EXAM_URL=

# Booking opens at HH:MM (24h). Watching starts 5 min before.
# Leave blank to start watching immediately. Also accepted as --open-time.
OPEN_TIME=

# ── Polling pace (watcher) ────────────────────────────────────
POLL_MIN=30
POLL_MAX=60

# How long to wait after the site returns an error / rate-limit page.
# Doubles on each consecutive error, capped at BACKOFF_MAX.
BACKOFF_START=120
BACKOFF_MAX=900

# ── Burst window around OPEN_TIME ─────────────────────────────
# Checks this fast for BURST_WINDOW seconds either side of OPEN_TIME,
# then returns to the normal pace. Ignored if OPEN_TIME is blank.
BURST_WINDOW=120
BURST_MIN=3
BURST_MAX=6

# ── Phone alerts (optional) ───────────────────────────────────
# Install the ntfy app, subscribe to a hard-to-guess topic name, and put the
# same name here. Only "slots open" + the exam URL is ever sent.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ── Timeouts ──────────────────────────────────────────────────
PAGE_LOAD_TIMEOUT=30
ELEMENT_TIMEOUT=15

# ── Chrome ────────────────────────────────────────────────────
# Blank = auto-detect. Only undetected-chromedriver needs this pinned.
CHROME_VERSION=

# ══════════════════════════════════════════════════════════════
# LEGACY — read by instance.py / proxy.py / rotating_proxy.py /
# tor_manager.py. None of these are on the watcher's run path.
# ══════════════════════════════════════════════════════════════
INSTANCES=1
EXAM_URLS=

PROXY_MODE=none

DATAIMPULSE_HOST=proxy.dataimpulse.com
DATAIMPULSE_PORT=823
DATAIMPULSE_USER=
DATAIMPULSE_PASS=

TOR_PATH=
TOR_CONTROL_PASS=
