# ── Instances ────────────────────────────────────────────────────────────────
# Number of browser windows to launch simultaneously
INSTANCES=1

# Exam URL(s), comma-separated.
# If you give 1 URL, every instance uses it.
# If you give multiple (e.g. 3 URLs for 3 instances), they are assigned
# round-robin: instance 0 → URL 0, instance 1 → URL 1, etc.
EXAM_URLS=

# Booking opens at this time (24-hour HH:MM). Leave blank to start immediately.
OPEN_TIME=

# ── Proxy mode ────────────────────────────────────────────────────────────────
# Options:  none | free | dataimpulse | tor
# none        — direct connection, no proxy
# free        — auto-fetches public HTTP proxies (unreliable but free)
# dataimpulse — residential rotating proxy via DataImpulse (paid, reliable)
# tor         — Tor onion routing, free, slow (~2-5s/request)
PROXY_MODE=none

# ── DataImpulse (PROXY_MODE=dataimpulse) ─────────────────────────────────────
DATAIMPULSE_HOST=proxy.dataimpulse.com
DATAIMPULSE_PORT=823
DATAIMPULSE_USER=
DATAIMPULSE_PASS=

# ── Tor (PROXY_MODE=tor) ──────────────────────────────────────────────────────
# Path to the tor.exe binary.
# Download Tor Expert Bundle from: https://www.torproject.org/download/tor/
# Example: C:\Users\You\Downloads\tor-expert-bundle\tor\tor.exe
TOR_PATH=
# Control port password — leave blank to use cookie auth (default)
TOR_CONTROL_PASS=

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_MIN=2
POLL_MAX=4

# ── Chrome ────────────────────────────────────────────────────────────────────
# Chrome major version. Leave blank for auto-detect (recommended).
# Check yours at chrome://version — first number, e.g. 136.0.7103.93 → 136
CHROME_VERSION=
